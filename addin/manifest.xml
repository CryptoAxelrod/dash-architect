<?xml version="1.0" encoding="UTF-8"?>
<!-- Dash Architect: task pane add-in.
     Replace every CryptoAxelrod.github.io/dash-architect with the HTTPS origin you deploy /addin, /engine,
     /render and /fixtures under (Office Add-ins only load over HTTPS — see
     reference/README.md for a GitHub Pages walkthrough of the same step).
     Deploy the WHOLE repo root, not just /addin: taskpane.html loads
     ../engine/*.js and ../render/*.js by relative path. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>bcf34b8b-d40d-457f-a44e-47f3782f8e18</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Dash Architect</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Dash Architect"/>
  <Description DefaultValue="Dashboards for Excel in minutes"/>
  <IconUrl DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://CryptoAxelrod.github.io/dash-architect/"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <!-- 1.9 for worksheet.shapes.addImage; everything else this add-in
         uses (range.valueTypes, workbook.settings, getResizedRange) is
         available earlier. -->
    <Sets>
      <Set Name="ExcelApi" MinVersion="1.9"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/taskpane.html?v=1.6"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="DashArchitect.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="DashArchitect.OpenPane">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>DashArchitectPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/"/>
        <bt:Url id="Commands.Url" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://CryptoAxelrod.github.io/dash-architect/addin/taskpane.html?v=1.6"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Dash Architect is ready"/>
        <bt:String id="Group.Label" DefaultValue="Dash Architect"/>
        <bt:String id="Button.Label" DefaultValue="Dash Architect"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open Dash Architect from the Home tab to build a dashboard from a range of cells."/>
        <bt:String id="Button.Tooltip" DefaultValue="Build a dashboard from a range of cells."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
